# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://fab:fab@localhost:5432/fab
# Generate with: openssl rand -hex 32
JWT_SECRET=
APP_URL=http://localhost:5173
PORT=4000
# Optional. Without it, reset links are printed to this console in development only.
SMTP_URL=
MAIL_FROM=no-reply@example.com
# Optional. Enables Ask AI and AI analysis. Keep it on the server only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Supabase: use the Session pooler string (port 5432) as DATABASE_URL, and set this to true.
DATABASE_SSL=false
# Optional, stricter: path to the CA certificate downloaded from your Supabase project's database settings.
DATABASE_CA_FILE=
